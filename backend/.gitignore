# Runtime data & generated output — jangan ikut di-commit,
# folder-nya tetap dipertahankan lewat .gitkeep
storage/uploads/*
storage/results/*
storage/samples/*
!storage/uploads/.gitkeep
!storage/results/.gitkeep
!storage/samples/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/
env/
*.egg-info/

# File percobaan / scratch yang nyasar
scratch_*.tif
